rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'ADMIN'] ||
        request.auth.token.email in ['laminedz.19@gmail.com', 'achridz.19@gmail.com', 'admin@soukidz.dz', 'admin@souqidz.com'] ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email.matches('.*lamine.*')
        ))
      );
    }

    // Top-up receipt images:
    // Only the user who owns the receipt or an admin can read it. No public access.
    // Only the user can upload to their own receipt folder, max 10MB, image type only.
    match /topUpReceipts/{uid}/{requestId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Listing images: anyone can view published ad images, only owner can upload/delete
    match /listings/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }
    
    // User profile avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
