rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'ADMIN'] ||
        request.auth.token.email in ['laminedz.19@gmail.com', 'achridz.19@gmail.com', 'admin@soukidz.dz', 'admin@souqidz.com'] ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email.matches('.*lamine.*')
        ))
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user to create/update their own profile, but prevent modifying role, isVerified, isBanned
      allow create: if isOwner(userId) && request.resource.data.role == "USER" && request.resource.data.isVerified == false && request.resource.data.isBanned == false;
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified', 'isBanned']))
        || isAdmin();
      allow delete: if false;
    }

    // Listings
    match /listings/{listingId} {
      // Anyone authenticated can read published listings, or owner/admin can read unpublished listings
      allow read: if resource == null || resource.data.status == 'PUBLISHED' || isOwner(resource.data.userId) || isAdmin();
      
      // Creating a new listing
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Updating a listing (owner can update, but cannot directly approve or modify payment status if not admin)
      allow update: if (isOwner(resource.data.userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPaid', 'status'])) || isAdmin();
      
      // Deleting a listing
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      // Users can only view their own payment records; admins can view all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Client can only create an initial payment audit entry for their own user ID
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // No client updates or deletions allowed on payments (must be handled by server/webhook)
      allow update, delete: if false;
    }

    // Top-up requests for balance recharging
    match /topUpRequests/{requestId} {
      function isValidProvider(provider) {
        return provider in ['BARIDIMOB', 'CCP', 'EDAHABIA', 'CIB'];
      }

      function isValidTopUpCreate() {
        let d = request.resource.data;
        return d.userId == request.auth.uid
          && d.amountDzd is int && d.amountDzd >= 200
          && isValidProvider(d.provider)
          && d.status == 'PENDING'
          && (d.receiptImageUri is string || d.reference is string);
      }

      // Read: Users can only read their own requests; Admin can read all
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      // Create: Authenticated users can only create a pending request for themselves, or admin
      allow create: if isAuthenticated() && (isAdmin() || isValidTopUpCreate());

      // Update: ONLY admin can update (approve / reject)
      allow update: if isAdmin();

      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // Platform settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wallets for user balances
    match /wallets/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin();
    }

    // Orders collection (buyers, sellers, and admins)
    match /orders/{orderId} {
      // Buyers can read their purchases, sellers can read received orders, admins can read all
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      
      // Authenticated users can place an order as the buyer
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      
      // Order status updates: Buyer, Seller, or Admin
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      
      // Order deletion restricted to administrators
      allow delete: if isAdmin();
    }
  }
}
